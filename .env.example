# Local self-hosted database (default)
DATABASE_URL="file:./dev.db"

# For Neon/Vercel, use the pooled URL for DATABASE_URL and direct URL for DIRECT_URL.
# DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DB?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/DB?sslmode=require"

# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Optional external email. Leave blank to use the built-in inbox only.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Nestora <noreply@yourdomain.com>"

# Optional hosted AI. Leave blank to use the built-in Nestora Assistant.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Local self-hosted database (default)
DATABASE_URL="file:./dev.db"

# For Vercel / production, switch to PostgreSQL:
# npm run db:postgres
# DATABASE_URL="postgresql://user:password@host:5432/nestora?sslmode=require"

AUTH_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Optional external email. Leave blank to use the built-in inbox only.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Nestora <noreply@yourdomain.com>"

# Optional hosted AI. Leave blank to use the built-in Nestora Assistant.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

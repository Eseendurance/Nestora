generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SEEKER
  AGENT
  ADMIN
}

enum ListingType {
  RENT
  SALE
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
}

enum AutomationType {
  CONTACT_FORM
  CONTACT_REPLY
  INQUIRY_CREATED
  APPOINTMENT_REQUESTED
  APPOINTMENT_UPDATED
  LISTING_PUBLISHED
  AI_CONTENT_GENERATED
  AI_CHAT
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         Role     @default(SEEKER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listings        Listing[]
  ownedOrganizations Organization[] @relation("OrganizationOwner")
  organizationMemberships OrganizationMember[]
  savedListings   SavedListing[]
  inquiries       Inquiry[]        @relation("Inquirer")
  received        Inquiry[]        @relation("Receiver")
  assignedLeads   Lead[]           @relation("AssignedLeads")
  leadActivities  LeadActivity[]   @relation("LeadActivityAuthor")
  contactMessages ContactMessage[]
  contactReplies  ContactReply[]
  appointments    Appointment[]    @relation("Booker")
  hosted          Appointment[]    @relation("Host")
  availability    AvailabilityRule[]
  automations     AutomationEvent[]
  aiConversations AiConversation[]
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  website     String?
  industry    String   @default("REAL_ESTATE")
  plan        String   @default("FREE")
  status      String   @default("ACTIVE")
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User                 @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members OrganizationMember[]
  listings Listing[]
  leads    Lead[]

  @@index([ownerId])
}

model OrganizationMember {
  organizationId String
  userId         String
  role           String   @default("AGENT")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
}

model Listing {
  id           String        @id @default(cuid())
  userId       String
  organizationId String?
  title        String
  slug         String        @unique
  propertyType String
  listingType  ListingType
  status       ListingStatus @default(PUBLISHED)
  price        Int
  bedrooms     Int
  bathrooms    Int
  areaSqm      Int
  city         String
  neighborhood String
  address      String
  latitude     Float?
  longitude    Float?
  description  String
  amenities    String        @default("")
  imageUrl     String?
  featured     Boolean       @default(false)
  views        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  savedBy      SavedListing[]
  inquiries    Inquiry[]
  appointments Appointment[]
  leads        Lead[]

  @@index([city])
  @@index([price])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId])
}

model SavedListing {
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
}

model Inquiry {
  id        String   @id @default(cuid())
  listingId String
  userId    String
  ownerId   String
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User     @relation("Inquirer", fields: [userId], references: [id], onDelete: Cascade)
  owner     User     @relation("Receiver", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model Lead {
  id             String   @id @default(cuid())
  organizationId String?
  assignedToId   String
  listingId      String?
  name           String
  email          String
  phone          String?
  message        String
  source         String   @default("PROPERTY_ENQUIRY")
  status         String   @default("NEW")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  assignedTo   User          @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: Cascade)
  listing      Listing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)
  activities   LeadActivity[]

  @@index([organizationId, status, createdAt])
  @@index([assignedToId, status, createdAt])
  @@index([listingId])
  @@unique([listingId, email])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  userId    String?
  kind      String   @default("NOTE")
  body      String
  createdAt DateTime @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation("LeadActivityAuthor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  replies   ContactReply[]

  @@index([status])
}

model ContactReply {
  id        String        @id @default(cuid())
  messageId String
  userId    String
  body      String
  createdAt DateTime      @default(now())
  message   ContactMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Appointment {
  id           String            @id @default(cuid())
  listingId    String
  userId       String
  ownerId      String
  scheduledAt  DateTime
  durationMins Int               @default(30)
  status       AppointmentStatus @default(PENDING)
  notes        String            @default("")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User    @relation("Booker", fields: [userId], references: [id], onDelete: Cascade)
  owner   User    @relation("Host", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, scheduledAt])
  @@index([userId, scheduledAt])
}

model AvailabilityRule {
  id                  String   @id @default(cuid())
  userId              String
  dayOfWeek           Int
  isAvailable       Boolean  @default(true)
  startMinutes      Int
  endMinutes          Int
  timeZone            String   @default("Africa/Lagos")
  bufferMinutes       Int      @default(15)
  maxBookingsPerDay   Int      @default(8)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek])
}

model AutomationEvent {
  id        String         @id @default(cuid())
  type      AutomationType
  title     String
  detail    String
  status    String         @default("IN_APP")
  channel   String         @default("INBOX")
  emailTo   String?
  read      Boolean        @default(false)
  createdAt DateTime       @default(now())
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?

  @@index([userId, read])
}

model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}
